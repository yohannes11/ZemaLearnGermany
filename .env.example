# Copy to .env (development) or /srv/zema/.env (server) and fill in. Never commit the real .env.

# Required in production: a long random string. Generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Your domain(s), comma-separated, and the same with https:// for CSRF.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Database. SQLite by default; for PostgreSQL use postgres://user:password@localhost:5432/zema
DATABASE_URL=sqlite:////srv/zema/data/db.sqlite3

# Hide the Django admin behind a less guessable address (keep the trailing slash).
DJANGO_ADMIN_URL=admin/

# Time zone for the daily/weekly/monthly reports.
DJANGO_TIME_ZONE=Africa/Addis_Ababa

# HSTS: start at 3600; raise to 31536000 once HTTPS has worked for a while.
DJANGO_SECURE_HSTS_SECONDS=3600

# Let every visitor edit and publish the site's text (testing only). Set to false for real use.
TEXT_EDITING_FOR_EVERYONE=true

# Google AdSense: leave ADSENSE_CLIENT empty to show placeholders.
ADSENSE_ENABLED=true
ADSENSE_CLIENT=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_BOTTOM=
